NEXT_PUBLIC_SITE_URL=https://www.vt1performance.cl

# Enlaces públicos de checkout. Si una URL está vacía, el sitio deriva la consulta a WhatsApp.
# No pongas claves secretas en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_PAYMENT_MENSUAL_URL=
NEXT_PUBLIC_PAYMENT_ESTUDIANTE_URL=
NEXT_PUBLIC_PAYMENT_ADULTO_MAYOR_URL=
NEXT_PUBLIC_PAYMENT_EMPRESAS_URL=
