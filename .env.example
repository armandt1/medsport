# URL pública final del sitio. Es fundamental para canonical, sitemap, Open Graph y datos estructurados.
# Actualmente se usa https://www.vt1performance.cl como fallback por la referencia pública histórica de Medsport.
# Si publicarás en otro dominio o subdominio, reemplázalo aquí.
NEXT_PUBLIC_SITE_URL=https://www.vt1performance.cl

# Enlaces de pago alojados por tu pasarela (Webpay / Flow / Mercado Pago / otra)
# No pongas claves secretas en variables NEXT_PUBLIC_*. Solo URLs públicas de checkout.
NEXT_PUBLIC_PAYMENT_ONE_URL=
NEXT_PUBLIC_PAYMENT_DUO_URL=
NEXT_PUBLIC_PAYMENT_TRIO_URL=
NEXT_PUBLIC_PAYMENT_FREE_URL=
